# =============================================================================
# CivicConnect Environment Configuration
# =============================================================================
# If left blank, CivicConnect automatically boots in High-Fidelity Local
# Simulation Mode with pre-seeded Indian municipal demo records.
# =============================================================================

# Firebase Configuration (Optional for local simulation)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps Platform (Optional - uses demo fallback when not configured)
VITE_GOOGLE_MAPS_API_KEY=

# Application Environment Mode (auto-detected as 'demo' if Firebase is empty)
VITE_APP_ENV=demo
